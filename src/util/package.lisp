;;;; src/util/package.lisp -- the packages, and the layering they encode.
;;;;
;;;; CRT.UTIL, CRT.SETTINGS, CRT.VT, CRT.PTY and CRT.TERMINAL must not mention
;;;; Objective-C or anything SBCL-only.  That is not tidiness: it is what lets
;;;; the ECL leg of CI load and test them, and what keeps the parts of this
;;;; program that can be reasoned about without a GPU separable from the parts
;;;; that cannot.

(defpackage #:cathode-ray-tube.util
  (:use #:cl)
  (:nicknames #:crt.util)
  (:export
   ;; math -- the arithmetic cool-retro-term's utils.js and fontmanager.cpp do,
   ;; reproduced exactly, quirks included.
   #:clamp #:lint #:smoothstep #:qround
   ;; color
   #:rgba #:rgba-r #:rgba-g #:rgba-b #:rgba-a #:make-rgba
   #:str-to-color #:color-to-str #:mix-color #:sum-color #:scale-color
   #:rgb2grey
   ;; resource
   #:resource #:*resource-directory*))

(defpackage #:cathode-ray-tube.metal
  (:use #:cl)
  (:nicknames #:crt.metal)
  (:local-nicknames (#:util #:cathode-ray-tube.util))
  (:export
   ;; device
   #:with-metal #:ensure-metal #:metal-available-p #:default-device #:device-name
   #:command-queue #:command-buffer #:reset-device #:null-object-p
   #:*device* #:*queue*
   ;; resources
   #:texture #:texture-p #:texture-handle #:texture-width #:texture-height
   #:texture-pixel-format #:make-texture #:release-texture
   #:texture-bytes #:texture-pixel #:bytes-per-pixel
   #:make-sampler #:with-mtl-region
   ;; library and pipelines
   #:default-library #:compile-library #:make-function
   #:pipeline #:clear-pipeline-cache
   ;; passes
   #:with-render-pass #:render-pass-descriptor #:use-pipeline
   #:draw-quad #:draw-instances
   #:bind-fragment-texture #:bind-fragment-sampler
   #:bind-fragment-bytes #:bind-vertex-bytes
   #:with-clear-color #:with-viewport
   ;; constants, generated by tools/metal-constants.sh
   #:*metal-constants*
   #:+pixel-format-r8unorm+ #:+pixel-format-rgba8unorm+
   #:+pixel-format-bgra8unorm+ #:+pixel-format-rgba16float+
   #:+texture-type-2d+
   #:+usage-shader-read+ #:+usage-shader-write+ #:+usage-render-target+
   #:+storage-mode-shared+ #:+storage-mode-managed+ #:+storage-mode-private+
   #:+load-action-dont-care+ #:+load-action-load+ #:+load-action-clear+
   #:+store-action-dont-care+ #:+store-action-store+
   #:+primitive-triangle+ #:+primitive-triangle-strip+
   #:+data-type-float+ #:+data-type-int+ #:+data-type-bool+
   #:+filter-nearest+ #:+filter-linear+
   #:+address-clamp-to-edge+ #:+address-repeat+))
